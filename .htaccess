<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect all requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>

# Protect sensitive directories
<FilesMatch "^(artisan|composer\.json|composer\.lock|\.env|\.gitignore|\.htaccess|phpunit\.xml|server\.php|web\.config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect .env file specifically
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect vendor directory
<IfModule mod_rewrite.c>
    RewriteRule ^vendor/.*$ - [F,L,NC]
</IfModule>

# Disable directory browsing
Options -Indexes